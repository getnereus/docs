  $('#pv').addEventListener('click', e => { if (e.target === e.currentTarget) closeDetail(); });
  $('#pvx').addEventListener('click', closeDetail);
  const on = (id, f) => $(id).addEventListener('click', f);
  on('#qvx', closeQR);
  on('#homeBtn', home);
  on('#prevBtn', () => go(-1));
  on('#nextBtn', () => go(1));
  on('#restartBtn', restart);
  on('#clearBtn', clearAll);
  on('#zoomOut', () => zoom(-1));
  on('#zoomIn', () => zoom(1));
  on('#notesBtn', () => toggleNotes());
  on('#num', () => { if (!follow) toggleIndex(); });
  on('#motionBtn', () => setMotion(!motion));
  on('#ixx', () => toggleIndex(false));
  on('#refsBtn', swapDeck);
  on('#nzOut', () => zoomNotes(-2));
  on('#nzIn', () => zoomNotes(2));
  on('#npx', () => toggleNotes(false));
  on('#langBtn', () => setLang(lang() === 'en' ? 'pt' : 'en'));
  on('#themeBtn', () => setTheme(shown() === 'dark' ? 'light' : 'dark'));
  on('#joyUp', back);
  on('#joyDown', fwd);
  on('#joyLeft', () => go(-1));
