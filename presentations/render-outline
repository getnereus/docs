"""




def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("outline", type=pathlib.Path, help="outline YAML file")
  parser.add_argument("--output", type=pathlib.Path, help="HTML output (default: outline name with .html)")
  parser.add_argument("--topics-url", help="base URL for references/*.md links (default: relative path)")
  parser.add_argument("--split", action="store_true",
                      help=f"the portal mode: write {STYLE_FILE} and {SCRIPT_FILE} next to the HTML instead of inlining them")
  parser.add_argument("--steps", action="store_true",
                      help="print how many steps the deck has (a slide, then each item it reveals) and write nothing")
  args = parser.parse_args()
  global TOPICS_URL
  TOPICS_URL = args.topics_url

  outline = yaml.safe_load(args.outline.read_text())
  errors = validate(outline, args.outline.parent)
  if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)

  if args.steps:
    print(deck_steps(render_html(outline, args.outline.parent)))
    return
  output = args.output or args.outline.with_suffix(".html")
  output.write_text(render_html(outline, args.outline.parent, split=args.split))
  print(output.resolve())
  if args.split:
    for name, text in ((STYLE_FILE, CSS), (SCRIPT_FILE, SCRIPT)):
      (output.parent / name).write_text(text)
      print((output.parent / name).resolve())


if __name__ == "__main__":
  main()
