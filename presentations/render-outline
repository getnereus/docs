  <button type="button" class="pill" id="themeBtn">◐</button>
  <button type="button" class="pill" id="langBtn" title="PT/EN (L)"><span data-l="en">EN</span>|<span data-l="pt">PT</span></button>
  <button type="button" class="pill" id="num" aria-haspopup="dialog" aria-controls="ix" aria-expanded="false" title="Index (I)"></button>
