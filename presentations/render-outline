"""

# ── Validation ──────────────────────────────────────────

# `$schema` names the outline's JSON Schema for an editor; `outlineVersion` is the schema's version, 1 when absent (#1700).
# Version 2 adds a slide's poll (#1722); every other field is the same in both.
TOP_KEYS = {"$schema", "outlineVersion", "deck", "acts", "slides", "references"}
OUTLINE_VERSIONS = (1, 2)
POLL_VERSION = 2
DECK_KEYS = {"name", "title", "subtitle", "accent", "pt"}
ACT_KEYS = {"name", "title", "question", "opening", "pt"}
SLIDE_KEYS = {"name", "act", "topic", "cover", "animations", "message", "accent", "heading", "subtitle", "screen", "terminal",
              "code", "diagram", "show", "dim", "reveal", "accumulate", "details", "source", "refs", "notes", "dependsOn", "status", "issue", "pt", "poll"}
# What fits on a phone (700 px high, less the slide's padding), in px: the header's fixed part (kicker and margins) and an item's padding.
SCREEN_HEIGHT, HEADER_BASE, ITEM_PADDING = 532, 76, 12
# A diagram on the phone: the slide's width (390 px less the gutters), its CSS cap (52vh of 700 px) and its top margin.
PHONE_WIDTH, DIAGRAM_MAX, DIAGRAM_MARGIN = 358, 364, 16
# A command's state in the CLI specs (docs/specs/cli, #477): `planned` names the issue that builds it.
STATUSES = ("built", "planned", "idea")
REFERENCE_KEYS = {"name", "title", "url", "author", "year", "about", "forUs", "pt"}
# The texts each language needs: a field in English asks for the same field under `pt`.
TRANSLATED = {"deck": ("title", "subtitle", "accent"), "act": ("title", "question"),
              "slide": ("message", "accent", "heading", "subtitle", "topic", "notes"),
              "reference": ("about", "forUs")}


def unknown_keys(where, item, allowed):
  return [f"{where}: unknown field '{key}'" for key in sorted(set(item) - allowed)]


def missing_pt(where, item, fields):
  pt = item.get("pt") or {}
  return [f"{where}: no pt.{field}" for field in fields if item.get(field) and not pt.get(field)]


def validate(outline, base=None):
  """Outline errors; with `base` (the outline's folder), code files and diagram parts are also checked."""
  errors = unknown_keys("outline", outline, TOP_KEYS)
  version = outline.get("outlineVersion", 1)
  if type(version) is not int or version not in OUTLINE_VERSIONS:
    errors.append(f"outline: outlineVersion {version!r} is not one of {', '.join(map(str, OUTLINE_VERSIONS))}")
  deck = outline.get("deck") or {}
  errors += unknown_keys("deck", deck, DECK_KEYS) + missing_pt("deck", deck, TRANSLATED["deck"])
  errors += accent_errors("deck", deck, "subtitle")
  acts = set()
  for act in outline.get("acts") or []:
    acts.add(act["name"])
    errors += unknown_keys(f"act {act['name']}", act, ACT_KEYS) + missing_pt(f"act {act['name']}", act, TRANSLATED["act"])
  names = {slide["name"] for slide in outline["slides"]}
  seen = set()
  for slide in outline["slides"]:
    name = slide["name"]
    errors += unknown_keys(name, slide, SLIDE_KEYS) + slide_errors(slide, acts, base)
    if "poll" in slide:
      errors += poll_errors(slide, version)
    for dependency in slide.get("dependsOn", []):
      if dependency not in names:
        errors.append(f"{name}: dependsOn unknown slide '{dependency}'")
      elif dependency not in seen:
        errors.append(f"{name}: dependsOn '{dependency}', which comes later")
    seen.add(name)
  return errors + validate_references(outline)


def slide_errors(slide, acts, base):
  name, pt = slide["name"], slide.get("pt") or {}
  errors = missing_pt(name, slide, TRANSLATED["slide"])
  if slide["act"] not in acts:
    errors.append(f"{name}: unknown act '{slide['act']}'")
  # The message is one sentence with no full stop; "?" and "!" stay (the engine's rule 4.3).
  for text in (slide.get("message"), pt.get("message")):
    if text and text.rstrip().endswith("."):
      errors.append(f"{name}: the message ends with a full stop: '{text}'")
  errors += slide_accent_errors(slide) + status_errors(slide)
  if base is not None:
    errors += link_errors(slide, base)
  if slide.get("screen") and len(pt.get("screen") or []) != len(slide["screen"]):
    errors.append(f"{name}: pt.screen must have {len(slide['screen'])} items")
  if slide.get("terminal"):
    errors += [f"{name}: {error}" for error in terminal_errors(slide["terminal"])]
  texts = {key: value for key, value in slide.items() if key not in ("terminal", "pt")}
  texts["pt"] = {key: value for key, value in pt.items() if key != "terminal"}
  if "{dim:" in json.dumps(texts, ensure_ascii=False):
    errors.append(f"{name}: {{dim:...}} is only for a terminal's output")
  for frame in ("code", "terminal", "diagram"):
    if pt.get(frame) and not slide.get(frame):
      errors.append(f"{name}: pt.{frame} without {frame}")
  if pt.get("terminal"):
    errors += [f"{name}: pt.terminal: {error}" for error in terminal_errors(pt["terminal"])]
  for code in (slide.get("code"), pt.get("code")):
    if base is not None and code and not (base / code["file"]).is_file():
      errors.append(f"{name}: code file '{code['file']}' not found")
  parts = set(slide.get("show", [])) | set(slide.get("dim", [])) | set(slide.get("reveal", []))
  if parts and not slide.get("diagram"):
    errors.append(f"{name}: show/dim/reveal without diagram")
  # Every part named must be a <g data-part> of the SVG, or a prefix of some (`dev` stands for `dev.1`, …).
  for diagram in (slide.get("diagram"), pt.get("diagram")):
    if base is None or not diagram:
      continue
    groups = set(re.findall(r'<g data-part="([\w.-]+)"', (base / diagram).read_text()))
    # A part the slide never names stays hidden: with none named, the slide shows an empty frame (#1706).
    if groups and not parts:
      errors.append(f"{name}: {diagram} shows none of its parts: name them in show, dim or reveal")
    for part in sorted(parts):
      if part not in groups and not any(group.startswith(part + ".") for group in groups):
        errors.append(f"{name}: part '{part}' is not in {diagram}")
    for part in sorted(set(slide.get("details") or {}) - groups):
      errors.append(f"{name}: details of '{part}', which is not in {diagram}")
  # A part's details: the same parts in both languages, each with its title, tip and body.
  details = {"en": slide.get("details") or {}, "pt": (slide.get("pt") or {}).get("details") or {}}
  for part in sorted(set(details["en"]) ^ set(details["pt"])):
    errors.append(f"{name}: details of '{part}' in one language only")
  for lang, parts_of in details.items():
    for part, detail in sorted(parts_of.items()):
      errors += [f"{name}: details of '{part}' ({lang}) with no {field}" for field in ("title", "tip", "body") if not detail.get(field)]
  return errors


# A slide's poll (#1722): a question to the room with a time to answer, named by the slide's name. A poll slide carries
# no list or frame, so the question and its options fit one phone screen, and no cover.
POLL_KEYS = {"kind", "question", "choices", "scale", "seconds", "pt"}
POLL_KINDS = ("choice", "scale", "text")
POLL_CHOICES, POLL_SCALE, POLL_SECONDS, POLL_DEFAULT = (2, 6), 10, (5, 300), 30


def poll_errors(slide, version):
  """What a slide's poll breaks; on an outline before POLL_VERSION, only that the version must rise."""
  name, poll = slide["name"], slide["poll"]
  where = f"{name}: poll"
  if version != POLL_VERSION:
    return [f"{where} needs outlineVersion {POLL_VERSION}: raise outlineVersion to {POLL_VERSION}"]
  if not isinstance(poll, dict):
    return [f"{where} is not a mapping"]
  pt = poll.get("pt") if isinstance(poll.get("pt"), dict) else {}
  errors = unknown_keys(where, poll, POLL_KEYS) + unknown_keys(f"{where}.pt", pt, {"question", "choices"})
  if poll.get("kind") not in POLL_KINDS:
    errors.append(f"{where}: kind {poll.get('kind')!r} is not one of {', '.join(POLL_KINDS)}")
  for field, text in (("question", poll.get("question")), ("pt.question", pt.get("question"))):
    if not isinstance(text, str) or not text.strip():
      errors.append(f"{where}: no {field}")
  errors += poll_choice_errors(where, poll, pt) + poll_scale_errors(where, poll)
  seconds = poll.get("seconds", POLL_DEFAULT)
  if type(seconds) is not int or not POLL_SECONDS[0] <= seconds <= POLL_SECONDS[1]:
    errors.append(f"{where}: seconds {seconds!r} must be an integer from {POLL_SECONDS[0]} to {POLL_SECONDS[1]}")
  crowded = [field for field in ("cover", "screen", "terminal", "code", "diagram") if slide.get(field)]
  if crowded:
    errors.append(f"{name}: a poll slide carries no {', '.join(crowded)}")
  return errors


def poll_choice_errors(where, poll, pt):
  """A choice poll has 2 to 6 choices, as many in Portuguese; no other kind has any."""
  choices, low, high = poll.get("choices"), *POLL_CHOICES
  if poll.get("kind") != "choice":
    return [f"{where}: choices only go with kind choice"] if choices is not None or "choices" in pt else []
  errors = []
  for field, items in (("choices", choices), ("pt.choices", pt.get("choices"))):
    if not isinstance(items, list) or not low <= len(items) <= high or not all(isinstance(item, str) and item.strip() for item in items):
      errors.append(f"{where}: {field} must be {low} to {high} texts")
  if isinstance(choices, list) and isinstance(pt.get("choices"), list) and len(pt["choices"]) != len(choices):
    errors.append(f"{where}: pt.choices must have {len(choices)} items")
  return errors


def poll_scale_errors(where, poll):
  """A scale poll goes from min to max, integers from 0, at most POLL_SCALE apart; no other kind has a scale."""
  scale = poll.get("scale")
  if poll.get("kind") != "scale":
    return [f"{where}: scale only goes with kind scale"] if scale is not None else []
  if not isinstance(scale, dict):
    return [f"{where}: scale needs min and max, integers"]
  errors = unknown_keys(f"{where}.scale", scale, {"min", "max"})
  low, high = scale.get("min"), scale.get("max")
  if type(low) is not int or type(high) is not int:
    errors.append(f"{where}: scale needs min and max, integers")
  elif not 0 <= low < high <= low + POLL_SCALE:
    errors.append(f"{where}: scale {low}-{high}: min must be 0 or more and below max, at most {POLL_SCALE} apart")
  return errors


def slide_names(outline, base=None):
  """The anchors a deck answers to: each slide, the parts of a long list (`<name>-2`), and each act's opening."""
  names = {f"act-{act['name']}" for act in outline.get("acts") or []}
  for slide in outline.get("slides") or []:
    names.add(slide["name"])
    names.update(f"{slide['name']}-{n}" for n, *_ in slide_parts(slide, base) if n > 1)
  return names


def text_strings(value):
  """Every string of an outline, at any depth: the texts the engine may turn into a link."""
  if isinstance(value, str):
    yield value
  elif isinstance(value, dict):
    for item in value.values():
      yield from text_strings(item)
  elif isinstance(value, list):
    for item in value:
      yield from text_strings(item)


# A message's length that fits the phone's title (docs/agent/decks.md, rule 3): over it, a warning, never an error, since
# the decks written before the check (#1702) break it often.
MESSAGE_FITS = 60


def fit_warnings(outline):
  """What renders but may not fit the screen: a message, in either language, over MESSAGE_FITS characters."""
  found = []
  for slide in outline.get("slides") or []:
    if not isinstance(slide, dict):
      continue
    pt = slide.get("pt") if isinstance(slide.get("pt"), dict) else {}
    for lang, part in (("", slide), ("pt.", pt)):
      message = part.get("message")
      if isinstance(message, str) and len(message) > MESSAGE_FITS:
        found.append(f"{slide.get('name')}: the {lang}message has {len(message)} characters, at most {MESSAGE_FITS} fit the screen")
  return found


def named_files(outline):
  """The files a deck names, relative to its folder, as written (#1701): its diagrams and code frames, the relative
  links of its texts (without their #anchor) and the topics it cites (`references/*.md`). A deck's package carries
  exactly these, and the Nereid refuses a package whose deck names a file it does not carry."""
  found = set()
  for slide in outline.get("slides") or []:
    if not isinstance(slide, dict):
      continue
    pt = slide.get("pt") if isinstance(slide.get("pt"), dict) else {}
    for part in (slide, pt):
      if isinstance(part.get("diagram"), str) and part["diagram"]:
        found.add(part["diagram"])
      if isinstance(part.get("code"), dict) and isinstance(part["code"].get("file"), str):
        found.add(part["code"]["file"])
  for text in text_strings(outline):
    for match in LINK.finditer(text):
      href = match.group(2)
      if not re.match(r"https?://|#|mailto:", href):
        found.add(href.partition("#")[0])
    found.update(TOPIC.findall(text))
  return sorted(path for path in found if path)


def link_errors(slide, base):
  """A link to another deck must reach a slide of it: a walkthrough never points to a command that left the reference."""
  pt = slide.get("pt") or {}
  texts = [slide.get(field) or "" for field in ("message", "heading", "subtitle")] + list(slide.get("screen") or [])
  texts += [pt.get(field) or "" for field in ("message", "heading", "subtitle")] + list(pt.get("screen") or [])
  errors = []
  for href in sorted({m.group(2) for text in texts for m in LINK.finditer(text)}):
    if re.match(r"https?://|#", href):
      continue
    path, _, anchor = href.partition("#")
    target = base / path
    if not target.is_file() and not target.with_suffix(".yaml").is_file():
      errors.append(f"{slide['name']}: link to a missing file '{href}'")
    elif anchor and target.suffix == ".html" and target.with_suffix(".yaml").is_file():
      if anchor not in slide_names(yaml.safe_load(target.with_suffix(".yaml").read_text()), target.parent):
        errors.append(f"{slide['name']}: link to a missing slide '{href}'")
  return errors


def status_errors(slide):
  name, status, issue = slide["name"], slide.get("status"), slide.get("issue")
  if status is not None and status not in STATUSES:
    return [f"{name}: status must be one of {', '.join(STATUSES)}: '{status}'"]
  if issue is not None and not (isinstance(issue, int) and issue > 0):
    return [f"{name}: issue must be an issue number: '{issue}'"]
  if status == "planned" and issue is None:
    return [f"{name}: a planned command names the issue that builds it"]
  if issue is not None and status is None:
    return [f"{name}: issue without status"]
  return []


def slide_accent_errors(slide):
  if slide.get("cover") and slide.get("accent"):
    return [f"{slide['name']}: a cover shows the deck's title and subtitle: its accent goes in deck.accent"]
  return accent_errors(slide["name"], slide, "message")


def accent_errors(where, item, field):
  """`accent`: the words of `field` in amber; found in the text, and never cutting through other markup."""
  errors, pt = [], item.get("pt") or {}
  for prefix, accent, text in (("", item.get("accent"), item.get(field)), ("pt.", pt.get("accent"), pt.get(field))):
    if not accent:
      continue
    if not text or accent not in text:
      errors.append(f"{where}: {prefix}accent '{accent}' is not in the {field}")
    elif any(part.count("{") != part.count("}") or part.count("**") % 2 or part.count("`") % 2 for part in text.partition(accent)):
      errors.append(f"{where}: {prefix}accent '{accent}' cuts through the markup of the {field}")
  return errors


def terminal_errors(terminal):
  """The terminal format of today (order 0035): long options only, in `options`, one per line; `Next steps:`
  with a blank line before and after."""
  errors = []
  for n, step in enumerate(terminal.get("steps") or [], 1):
    run = step.get("run", "")
    if not run:
      errors.append(f"terminal step {n}: no run")
    if re.search(r"(^|\s)-", run):
      errors.append(f"terminal step {n}: options go in `options`, one per line: '{run}'")
    for option in step.get("options") or []:
      if not re.fullmatch(r"--[a-z][\w-]*( .+)?", str(option)):
        errors.append(f"terminal step {n}: '{option}' is not a long option")
    if "stepwise" in step and not isinstance(step["stepwise"], bool):
      errors.append(f"terminal step {n}: stepwise is true or false")
    elif step.get("stepwise") and not step.get("output"):
      errors.append(f"terminal step {n}: stepwise with no output")
    lines = (step.get("output") or "").split("\n")
    for i, line in enumerate(lines):
      if line.strip() == "Next steps:" and not (0 < i < len(lines) - 1 and lines[i - 1] == "" and lines[i + 1] == ""):
        errors.append(f"terminal step {n}: 'Next steps:' needs a blank line before and after")
  if not terminal.get("steps"):
    errors.append("terminal with no steps")
  return errors


def validate_references(outline):
  """`references`: one slide per source (a QR code needs one URL); `refs` on a slide names its sources."""
  errors, names = [], []
  for ref in outline.get("references") or []:
    name = ref.get("name", "")
    if name in names:
      errors.append(f"reference '{name}': defined twice")
    names.append(name)
    errors += unknown_keys(f"reference '{name}'", ref, REFERENCE_KEYS) + missing_pt(f"reference '{name}'", ref, TRANSLATED["reference"])
    if not ref.get("title"):
      errors.append(f"reference '{name}': no title")
    if not re.fullmatch(r"https?://\S+", ref.get("url") or ""):
      errors.append(f"reference '{name}': url must be http(s)")
  cited = set()
  for slide in outline["slides"]:
    for ref in slide.get("refs") or []:
      cited.add(ref)
      if ref not in names:
        errors.append(f"{slide['name']}: refs unknown reference '{ref}'")
  errors.extend(f"reference '{name}': no slide cites it" for name in names if name not in cited)
  return errors


# ── Text ────────────────────────────────────────────────

# `[text](href)` on a slide: a link to another deck's slide (`../specs/cli/reefs/edge.html#zone-create`) or a page.
LINK = re.compile(r"\[([^\]]+)\]\(([^()\s']+)\)")
CONCEPT = re.compile(r"\{(" + "|".join((*CONCEPTS, *ROLES)) + r"):([^{}]+)\}")
URL = re.compile(r"https?://[^\s<>\"')`]+[^\s<>\"').,;:`]")
CODE = re.compile(r"`[^`\n]+?`")
TOPIC = re.compile(r"references/[\w.-]+\.md")

# `--topics-url`: published builds link topics to their rendered page on GitHub, not the raw .md.
TOPICS_URL = None


def inline(text, accent=None):
  """Inline markup on a slide: **bold**, _emphasis_, `code`, {reef:name} in its concept's colour; `accent` in amber."""
  if accent and accent in text:
    before, _, after = text.partition(accent)
    return f"{inline(before)}<em>{inline(accent)}</em>{inline(after)}"
  out = html.escape(text, quote=False)
  out = LINK.sub(lambda m: f"<a href='{m.group(2)}'>{m.group(1)}</a>", out)
  out = CONCEPT.sub(lambda m: f"<span class='cx-{m.group(1)}'>{m.group(2)}</span>", out)
  out = re.sub(r"`(.+?)`", r"<code class='mono'>\1</code>", out)
  out = re.sub(r"(?<![\w])_(.+?)_(?![\w])", r"<em>\1</em>", out)
  return re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", out)


def topic_href(token, topics_dir, base):
  if TOPICS_URL:
    return f"{TOPICS_URL.rstrip('/')}/{pathlib.Path(token).name}"
  return os.path.relpath(topics_dir / pathlib.Path(token).name, base)


def linkify(text, topics_dir, base):
  """Escape notes and turn URLs and references/*.md mentions into links."""
  out, last = [], 0
  pattern = re.compile(f"{CODE.pattern}|{URL.pattern}|{TOPIC.pattern}")
  for match in pattern.finditer(text):
    out.append(html.escape(text[last:match.start()], quote=False))
    token = match.group(0)
    last = match.end()
    if token.startswith("`"):
      out.append(html.escape(token, quote=False))
      continue
    href = token if token.startswith("http") else topic_href(token, topics_dir, base)
    out.append(f"<a href='{html.escape(href)}' target='_blank'>{html.escape(token)}</a>")
  out.append(html.escape(text[last:], quote=False))
  return notes_markup("".join(out))


def notes_markup(escaped):
  """Light markdown in notes (already HTML-escaped): **bold**, `code`, one paragraph per blank line, "- " items."""
  out = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", escaped)
  out = re.sub(r"`([^`\n]+?)`", r"<code>\1</code>", out)
  blocks = []
  for block in re.split(r"\n\s*\n", out.strip()):
    lines = block.split("\n")
    if all(line.startswith("- ") for line in lines):
      blocks.append("<ul>" + "".join(f"<li>{line[2:]}</li>" for line in lines) + "</ul>")
    else:
      blocks.append(f"<p>{'<br>'.join(lines)}</p>")
  return "".join(blocks)


def notes_html(slide, lang, references, base):
  text = slide.get("notes", "") if lang == "en" else (slide.get("pt") or {}).get("notes", "")
  out = linkify(text, base / "references", base) if text else ""
  cited = [references[name] for name in slide.get("refs") or [] if name in references]
  if cited:
    links = "".join(f"<li><a href='#ref-{html.escape(ref['name'])}' data-go='ref-{html.escape(ref['name'])}'>{html.escape(ref['title'])}</a></li>" for ref in cited)
    out += f"<p><strong>{WORDS[lang]['sources']}:</strong></p><ul>{links}</ul>"
  return out


# ── Content blocks ──────────────────────────────────────

def term_bar(title):
  return f"<div class='bar'><span class='dots'><i></i><i></i><i></i></span><span>{html.escape(title)}</span></div>"


def command_lines(run, options):
  """`$ nereus <group> <verb> <name>`, then one long option per line, 4 spaces in (2 from where `nereus` starts)."""
  words = run.split()
  binary, rest = words[0], words[1:]
  group = rest[0] if rest else None
  concept = GROUPS.get(group)
  spans = [f"<span class='t-bin'>{html.escape(binary)}</span>"]
  for i, word in enumerate(rest):
    if i == 0 and len(rest) > 1:
      spans.append(f"<span class='{f'cx-{concept}' if concept else 't-grp'}'>{html.escape(word)}</span>")
    elif i == 1:
      spans.append(f"<span class='t-verb'>{html.escape(word)}</span>")
    else:
      spans.append(f"<span class='{f'cx-{concept}' if concept else 't-val'}'>{html.escape(word)}</span>")
  continued = " \\" if options else ""
  lines = [f"<span class='ln'><span class='t-ps'>$ </span>{' '.join(spans)}{continued}</span>"]
  for n, option in enumerate(options):
    name, _, value = str(option).partition(" ")
    tail = " \\" if n < len(options) - 1 else ""
    cls = f"cx-{OPTIONS[name]}" if name in OPTIONS else "t-val"
    shown = f" <span class='{cls}'>{html.escape(value)}</span>" if value else ""
    lines.append(f"<span class='ln'>    <span class='t-opt'>{html.escape(name)}</span>{shown}{tail}</span>")
  return "".join(lines)


DIM = re.compile(r"\{dim:([^{}]+)\}")


def output_markup(line, marks=True):
  """An output line's inline markup (#1455): {dim:...} in the comment grey, {reef:...} in its concept's colour, and
  with `marks`, ✓ green, ✗ red and a lone ~ (between spaces or at the end) amber, so ~/path stays plain."""
  out = html.escape(line, quote=False)
  out = DIM.sub(lambda m: f"<span class='t-c'>{m.group(1)}</span>", out)
  out = CONCEPT.sub(lambda m: f"<span class='cx-{m.group(1)}'>{m.group(2)}</span>", out)
  if marks:
    out = out.replace("✓", "<span class='t-ok'>✓</span>").replace("✗", "<span class='t-bad'>✗</span>")
    out = re.sub(r"(?<= )~(?= |$)", "<span class='t-val'>~</span>", out)
  return out


def output_line(line):
  """One output line: a line that starts with ✓ or ✗, or `Next steps:`, takes its colour whole; any other, its inline marks."""
  text = output_markup(line, marks=False)
  if line.startswith("✓"):
    return f"<span class='ln wrap'><span class='t-ok'>{text}</span></span>"
  if line.startswith("✗"):
    return f"<span class='ln wrap'><span class='t-bad'>{text}</span></span>"
  if line.strip() == "Next steps:":
    return f"<span class='ln wrap'><span class='t-label'>{text}</span></span>"
  return f"<span class='ln wrap'>{output_markup(line) or ' '}</span>"


def render_terminal(terminal):
  """A terminal: each command a `.grp.cmd` (typed), its output a `.grp.out` (line by line), a blank line between."""
  groups, steps = [], terminal["steps"]
  for n, step in enumerate(steps):
    comment = f"<span class='ln wrap'><span class='t-c'># {html.escape(step['comment'])}</span></span>" if step.get("comment") else ""
    groups.append(f"<span class='grp cmd'>{comment}{command_lines(step['run'], step.get('options') or [])}</span>")
    lines = (step.get("output") or "").rstrip("\n").split("\n") if step.get("output") else []
    if n < len(steps) - 1:
      lines.append("")
    if lines:
      stepwise = " data-stepwise='1'" if step.get("stepwise") else ""
      groups.append(f"<span class='grp out'{stepwise}>{''.join(output_line(line) for line in lines)}</span>")
  return f"<div class='term'>{term_bar(terminal.get('cwd', '~/example'))}<pre>{''.join(groups)}</pre>{copy_button(steps)}</div>"


def copy_text(steps):
  """What the copy button copies: the commands as typed, one long option per line, never the prompt or the output."""
  commands = []
  for step in steps:
    options = [str(option) for option in step.get("options") or []]
    commands.append(" \\\n    ".join([step["run"], *options]))
  return "\n".join(commands)


def copy_button(steps):
  label = "".join(f"<span lang='{lang}'>{WORDS[lang]['copy']}</span>" for lang in LANGS)
  return f"<button type='button' class='cp' aria-label='Copy' data-copy='{html.escape(copy_text(steps))}'>{label}</button>"


def line_set(spec, default):
  if not spec:
    return default
  lines = set()
  for part in str(spec).split(","):
    start, _, end = part.partition("-")
    lines.update(range(int(start), int(end or start) + 1))
  return lines


def highlight_yaml(line):
  esc = lambda text: html.escape(text, quote=False)
  item = re.match(r"^(\s*- )(.*)$", line)
  if item and not re.match(r"^[\w.-]+:(\s|$)", item.group(2)):
    return f"{esc(item.group(1))}<span class='s'>{esc(item.group(2))}</span>"
  match = re.match(r"^(\s*)(- )?([\w.-]+)(:)(\s.*|)$", line)
  if not match:
    return esc(line)
  indent, dash, key, colon, rest = match.groups()
  value = esc(rest)
  value = re.sub(r"(\$\{[^}]+\})", r"<span class='p'>\1</span>", value)
  if "<span" not in value and re.fullmatch(r"\s*\d+", rest):
    value = f"<span class='n'>{value}</span>"
  elif "<span" not in value and rest.strip():
    value = f"<span class='s'>{value}</span>"
  return f"{indent}{dash or ''}<span class='k'>{esc(key)}</span>{colon}{value}"


def render_code(code, base):
  """An editor frame on a file of the repository, never a copy: `lines` picks lines, `focus` dims the rest."""
  source = (base / code["file"]).read_text().splitlines()
  shown = sorted(line_set(code.get("lines"), set(range(1, len(source) + 1))))
  focus = line_set(code.get("focus"), set())
  def numbered(number):
    css = "focus" if number in focus else ("dim" if focus else "")
    return f"<span class='ln {css}'><span class='no'>{number}</span>{highlight_yaml(source[number - 1])}</span>"
  return f"<div class='code'>{term_bar(pathlib.Path(code['file']).name)}<pre>{''.join(numbered(n) for n in shown)}</pre></div>"


def render_diagram(slide, base):
  """An SVG of the repository with `<g data-part>` groups: `show` at full colour, `dim` faded, `reveal` one per step."""
  shown, dimmed, revealed = set(slide.get("show", [])), set(slide.get("dim", [])), slide.get("reveal", [])
  named = lambda part, names: any(part == name or part.startswith(name + ".") for name in names)
  def group(match):
    part = match.group(1)
    if named(part, shown) or named(part, revealed):
      return match.group(0)
    css = "part-dim" if named(part, dimmed) else "part-hidden"
    return f'<g data-part="{part}" class="{css}">'
  svg = re.sub(r'<g data-part="([\w.-]+)">', group, (base / slide["diagram"]).read_text())
  svg = re.sub(r"<\?xml[^>]*\?>\s*", "", svg)
  accumulate = " data-accumulate='1'" if slide.get("accumulate") else ""
  return f"<div class='diagram' data-reveal='{html.escape(json.dumps(revealed))}'{accumulate}>{svg}{part_details(slide)}</div>"


def part_details(slide):
  """A part's tip and details, one template per language; the script shows the language the deck is in."""
  out = ""
  for lang in LANGS:
    for part, detail in (text_of(slide, "details", lang) or {}).items():
      out += (f"<template data-detail='{html.escape(part)}' data-lang='{lang}' data-tip='{html.escape(detail['tip'])}'>"
              f"<h3>{inline(detail['title'])}</h3><p>{inline(detail['body'])}</p></template>")
  return out


def qr_svg(url):
  """A QR code for `url`, as inline SVG: dark modules on white, sized by CSS, no network needed."""
  import segno
  return segno.make(url, error="m").svg_inline(scale=1, border=2, dark="#0a0e1a", light="#ffffff", omitsize=True)


# ── Slides ──────────────────────────────────────────────

def text_of(item, field, lang):
  return item.get(field) if lang == "en" else (item.get("pt") or {}).get(field)


def section(name, langs, extra="", notes=None, css="", units=None):
  """A slide: one div per language, the language-neutral content after them, the notes as templates; a slide of the
  main deck carries its units (`data-units`, see slide_units)."""
  body = "".join(f"<div lang='{lang}'>{langs[lang]}</div>" for lang in LANGS)
  templates = "".join(f"<template data-notes='{lang}'>{notes[lang]}</template>" for lang in LANGS if notes and notes[lang])
  count = "" if units is None else f" data-units='{units}'"
  return f"<section class='slide{css}' id='{html.escape(name)}'{count}>{body}{extra}{templates}</section>"


# The units of a slide (#1760): what one step forward reveals when nothing animates, the same on every screen. An item
# (`.st`) is one; a terminal command is two (typed, then run), and each further output line of a `stepwise` one (a blank
# line goes with the next); a diagram part to reveal is one. A press that only ends an animation (the typing, the
# output) is no unit, so a step means the same on a speaker's screen that animates and a follower's that does not. A
# step of the deck is a slide at its start or after one of its units: the deck has the sum of (units + 1) steps.
ITEM_CLASS = re.compile(r"class='([^']*)'")


def item_units(markup):
  return sum("st" in found.split() for found in ITEM_CLASS.findall(markup))


def terminal_units(terminal):
  total, steps = 0, terminal["steps"]
  for step in steps:
    total += 2
    if step.get("stepwise") and step.get("output"):
      filled = sum(1 for line in step["output"].rstrip("\n").split("\n") if line.strip())
      total += max(0, filled - 1)
  return total


def frame_units(slide):
  if slide.get("terminal"):
    return terminal_units(slide["terminal"])
  if slide.get("diagram"):
    return len(slide.get("reveal", []))
  return 0


def deck_steps(markup):
  """The steps of a rendered deck: one per slide of the main deck, plus its units."""
  main = markup.split('<div data-deck="refs">', 1)[0]
  return sum(int(found) + 1 for found in re.findall(r"<section class='slide[^']*' id='[^']*' data-units='(\d+)'", main))


def status_tag(slide, lang):
  """The command's state, after the label: `built`, `planned #475` or `idea` (#477)."""
  if not slide.get("status"):
    return ""
  issue = f" #{slide['issue']}" if slide.get("issue") else ""
  return f"<span class='tag {slide['status']}'>{WORDS[lang][slide['status']]}{issue}</span>"


def head(label, message, subtitle=None, accent=None, tag="", steps=False):
  """A spaced uppercase label, the message as a big title with its accent in amber, and the subtitle, its own step when `steps` is on."""
  out = f"<div class='kicker'>{inline(label)}{tag}</div>" if label else ""
  # A poll slide may leave the message out: its question is the slide's title (#1722).
  out += f"<h2>{inline(message, accent)}</h2>" if message else ""
  lead = "lead st" if steps else "lead"
  return out + (f"<p class='{lead}'>{inline(subtitle)}</p>" if subtitle else "")


def cover(deck, lang):
  """The deck's title at once, then its subtitle."""
  out = f"<h1>{inline(text_of(deck, 'title', lang))}</h1>"
  if text_of(deck, "subtitle", lang):
    out += f"<p class='st sub'>{inline(text_of(deck, 'subtitle', lang), text_of(deck, 'accent', lang))}</p>"
  return out


def act_label(act, slide, lang, part=None):
  label = " · ".join(text for text in (text_of(act, "title", lang), text_of(slide, "topic", lang)) if text)
  return f"{label} · {part}" if part else label


def text_height(text, chars_per_line, line_height):
  """The height of `text` on the phone, wrapped at `chars_per_line`, without its markup."""
  plain = html.unescape(re.sub(r"<[^>]+>", "", inline(str(text or ""))))
  return line_height * max(1, -(-len(plain) // chars_per_line))


def header_height(slide):
  return HEADER_BASE + text_height(slide.get("message"), 27, 30) + text_height(slide.get("subtitle") or slide.get("heading"), 42, 25)


def diagram_height(slide, base):
  """A diagram's height on the phone, from its viewBox at the phone's width, at most 52vh (its CSS); None without a viewBox."""
  heights = []
  for diagram in (slide.get("diagram"), (slide.get("pt") or {}).get("diagram")):
    box = diagram and re.search(r'viewBox="[\d.-]+[ ,]+[\d.-]+[ ,]+([\d.]+)[ ,]+([\d.]+)"', (base / diagram).read_text())
    if diagram and not box:
      return None
    if box:
      width, height = float(box.group(1)), float(box.group(2))
      heights.append(DIAGRAM_MARGIN + min(PHONE_WIDTH * height / width, DIAGRAM_MAX))
  return max(heights)


def fitting_chunks(slide, frame_height=0):
  """Consecutive items that fit on one phone screen, the tightest the deck is read on; the taller language decides.

  A diagram (`frame_height`) is drawn on the last part only: the items that do not fit beside it move to a part before.
  """
  versions = [slide, slide.get("pt") or {}]
  head_height = max(header_height({**slide, **version}) for version in versions)
  texts = list(zip(*(version.get("screen") or slide["screen"] for version in versions)))
  heights = [ITEM_PADDING + max(text_height(text, 42, 24) for text in item) for item in texts]
  chunks, start, used = [], 0, head_height
  for index, height in enumerate(heights):
    if index > start and used + height > SCREEN_HEIGHT:
      chunks.append((start, index))
      start, used = index, head_height
    used += height
  last, used = len(texts), head_height + frame_height
  while last > start and used + heights[last - 1] <= SCREEN_HEIGHT:
    last, used = last - 1, used + heights[last - 1]
  return chunks + ([(start, last)] if last > start else []) + [(last, len(texts))]


def slide_parts(slide, base=None):
  """A list continues on the next slides, with the same message, only when it does not fit (rule 4.3).

  A diagram is measured by its viewBox (#1458). A terminal, a code frame or a diagram with no viewBox has a height the
  text does not tell: its slide keeps at most two items.
  """
  screen = slide.get("screen") or []
  height = diagram_height(slide, base) if screen and slide.get("diagram") and base is not None else None
  if height is not None:
    chunks = fitting_chunks(slide, height)
  elif slide.get("terminal") or slide.get("code") or slide.get("diagram"):
    chunks = [(start, start + 2) for start in range(0, len(screen), 2)] or [(0, 0)]
  else:
    chunks = fitting_chunks(slide) if screen else [(0, 0)]
  return [(n, len(chunks), start, end) for n, (start, end) in enumerate(chunks, 1)]


def plain_list(texts, steps=True):
  """Plain items, `**Label:** text`, revealed in turn unless `steps` is off (`animations: none`).

  An item that starts with `- ` is a sub-item of the one before: a sibling in the HTML, indented, so it is revealed and dimmed on its own.
  """
  def item(text):
    classes = " ".join(name for name, on in (("st", steps), ("sub", text.startswith("- "))) if on)
    attribute = f" class='{classes}'" if classes else ""
    return f"<li{attribute}>{inline(text.removeprefix('- '))}</li>"
  return "<ul class='steps plain'>" + "".join(item(text) for text in texts) + "</ul>"


def act_titles(act):
  return {lang: text_of(act, "title", lang) or act.get("title") for lang in LANGS}


def frame(slide, base):
  """The slide's terminal, code frame or diagram, the same in both languages unless `pt` has its own."""
  if slide.get("terminal"):
    return render_terminal(slide["terminal"])
  if slide.get("code"):
    return render_code(slide["code"], base)
  if slide.get("diagram"):
    return render_diagram(slide, base)
  return ""


def poll_question(slide, lang):
  """A poll's question in a language: the index's title of a poll slide with no message."""
  poll = slide.get("poll") or {}
  return poll.get("question") if lang == "en" else (poll.get("pt") or {}).get("question")


def render_poll(slide):
  """A poll (#1722): the question and its options in each language, still, then the live state's place, which the
  screens of a live session fill: the clock, the count of answers and, after the time, each option's bar. The data
  attributes are what those screens read; with no session the slide shows the question and its options."""
  poll = slide["poll"]
  kind, seconds, scale = poll["kind"], poll.get("seconds", POLL_DEFAULT), poll.get("scale") or {}
  attributes = {"poll": slide["name"], "kind": kind, "seconds": seconds}
  if kind == "choice":
    attributes["choices"] = len(poll["choices"])
  if kind == "scale":
    attributes.update(min=scale["min"], max=scale["max"])
  data = "".join(f" data-{key}='{html.escape(str(value))}'" for key, value in attributes.items())
  langs = []
  for lang in LANGS:
    question = poll["question"] if lang == "en" else poll["pt"]["question"]
    out = f"<p class='pq'>{inline(question)}</p>"
    if kind == "choice":
      choices = poll["choices"] if lang == "en" else poll["pt"]["choices"]
      out += "<ol class='po choice'>" + "".join(
        f"<li data-option='{n}'><b>{chr(65 + n)}</b><span>{inline(text)}</span><i data-poll-bar></i><output data-poll-votes></output></li>"
        for n, text in enumerate(choices)) + "</ol>"
    elif kind == "scale":
      out += "<ol class='po scale'>" + "".join(
        f"<li data-option='{value}'><b>{value}</b><i data-poll-bar></i><output data-poll-votes></output></li>"
        for value in range(scale["min"], scale["max"] + 1)) + "</ol>"
    else:
      out += f"<p class='po text'>{WORDS[lang]['pollText']}</p>"
    time = WORDS[lang]["pollTime"].format(seconds=seconds)
    out += f"<p class='pt' data-poll-time>{time}</p>"
    langs.append(f"<div lang='{lang}'>{out}</div>")
  live = "<div class='pl' data-poll-live hidden><output data-poll-clock></output><output data-poll-count></output></div>"
  return f"<div class='poll'{data}>{''.join(langs)}{live}</div>"


def render_slide(slide, outline, acts, references, base, index):
  act, deck = acts[slide["act"]], outline["deck"]
  notes = {lang: notes_html(slide, lang, references, base) for lang in LANGS}
  extra = render_poll(slide) if slide.get("poll") else frame(slide, base)
  pt = slide.get("pt") or {}
  if pt.get("terminal") or pt.get("code") or pt.get("diagram"):
    # A frame of its own in Portuguese (#1457): one per language, the one on screen shown and stepped through.
    extra = f"<div lang='en'>{extra}</div><div lang='pt'>{frame({**slide, **pt}, base)}</div>"
  out = []
  for n, total, start, end in slide_parts(slide, base):
    langs, heads = {}, {}
    for lang in LANGS:
      part = f"{n}/{total}" if total > 1 else None
      if slide.get("cover"):
        heads[lang] = (inline(text_of(act, "title", lang)), inline(text_of(deck, "title", lang) or deck["title"]))
      else:
        message = text_of(slide, "message", lang) or poll_question(slide, lang)
        heads[lang] = (inline(act_label(act, slide, lang, part)), inline(message, text_of(slide, "accent", lang)))
      if slide.get("cover"):
        content = cover(deck, lang)
      else:
        content = head(act_label(act, slide, lang, part), text_of(slide, "message", lang),
                       text_of(slide, "subtitle", lang) or text_of(slide, "heading", lang), text_of(slide, "accent", lang),
                       status_tag(slide, lang), slide.get("animations") != "none")
      screen = (text_of(slide, "screen", lang) or [])[start:end]
      if screen:
        content += plain_list(screen, slide.get("animations") != "none")
      if slide.get("source"):
        content += f"<p class='src'>{WORDS[lang]['source']}: {inline(slide['source'])}</p>"
      langs[lang] = content
    name = slide["name"] if n == 1 else f"{slide['name']}-{n}"
    index.append({"name": name, "act": act_titles(act), "heads": heads})
    units = item_units(langs["en"]) + (frame_units(slide) if n == total else 0)
    out.append(section(name, langs, extra if n == total else "", notes, " cover" if slide.get("cover") else "", units))
  return "".join(out)


def render_act_intro(act, index):
  """An act with a question opens with it, unless `opening: false`."""
  index.append({"name": f"act-{act['name']}", "act": act_titles(act),
                "heads": {lang: (inline(text_of(act, "title", lang)), inline(text_of(act, "question", lang))) for lang in LANGS}})
  return section(f"act-{act['name']}", {lang: head(text_of(act, "title", lang), text_of(act, "question", lang)) for lang in LANGS}, units=0)


def qr_button(url, svg=""):
  """A QR code as a button that opens it in the overlay, with its link; an empty one copies it from its slide."""
  return f"<button type='button' class='qb' data-u='{html.escape(url)}' aria-label='QR code'>{svg}</button>"


def render_references(outline, index):
  """The reference deck: a slide listing the sources, then one slide per source with its QR code."""
  refs = outline.get("references") or []
  if not refs:
    return ""
  def entry(ref):
    by = " · ".join(str(part) for part in (ref.get("author"), ref.get("year")) if part)
    link = f"<a href='#ref-{html.escape(ref['name'])}' data-go='ref-{html.escape(ref['name'])}'>{html.escape(ref['title'])}</a>"
    return f"<li><span>{link}{f' <small>· {html.escape(by)}</small>' if by else ''}</span>{qr_button(ref['url'])}</li>"
  listing = "<ul class='refs'>" + "".join(entry(ref) for ref in refs) + "</ul>"
  out = [section("references", {lang: head(WORDS[lang]["references"], WORDS[lang]["sources"]) for lang in LANGS}, listing)]
  index.append({"name": "references", "act": None, "heads": {lang: (WORDS[lang]["references"], WORDS[lang]["sources"]) for lang in LANGS}})
  for n, ref in enumerate(refs, 1):
    by = " · ".join(str(part) for part in (ref.get("author"), ref.get("year")) if part)
    langs = {}
    for lang in LANGS:
      texts = [f"**{WORDS[lang][field]}:** {text_of(ref, field, lang)}" for field in ("about", "forUs") if text_of(ref, field, lang)]
      langs[lang] = head(f"{WORDS[lang]['references']} · {n}/{len(refs)}", ref["title"], by or None) + (plain_list(texts, False) if texts else "")
    url = html.escape(ref["url"])
    link = f"<p class='url'>{qr_button(ref['url'], qr_svg(ref['url']))}<a href='{url}' target='_blank' rel='noopener'>{url}</a></p>"
    out.append(section(f"ref-{ref['name']}", langs, link))
    index.append({"name": f"ref-{ref['name']}", "act": None,
                  "heads": {lang: (f"{WORDS[lang]['references']} · {n}/{len(refs)}", inline(ref["title"])) for lang in LANGS}})
  return "".join(out)


def render_slides(outline, base, index):
  acts = {act["name"]: act for act in outline["acts"]}
  references = {ref["name"]: ref for ref in outline.get("references") or []}
  out, opened = [], set()
  for slide in outline["slides"]:
    act = acts[slide["act"]]
    if act["name"] not in opened:
      opened.add(act["name"])
      if act.get("question") and act.get("opening", True):
        out.append(render_act_intro(act, index))
    out.append(render_slide(slide, outline, acts, references, base, index))
  return "".join(out)


def render_index(entries, deck):
  """The slide index of one deck: per slide its number, label and message in both languages, under its act's title (#1450)."""
  out, act = [], None
  for n, entry in enumerate(entries, 1):
    if entry["act"] and entry["act"] != act:
      act = entry["act"]
      out.append("<li class='ixa'>" + "".join(f"<span lang='{lang}'>{inline(act[lang])}</span>" for lang in LANGS) + "</li>")
    name = html.escape(entry["name"])
    text = "".join(f"<span lang='{lang}'>{f'<small>{label}</small>' if label else ''}{message}</span>"
                   for lang, (label, message) in ((lang, entry["heads"][lang]) for lang in LANGS))
    out.append(f"<li><a href='#{name}' data-go='{name}'><span class='ixn'>{n}</span><span class='ixt'>{text}</span></a></li>")
  return f"<ol data-ix='{deck}'>{''.join(out)}</ol>"


STYLE_FILE, SCRIPT_FILE = "deck.css", "deck.js"


def render_html(outline, base, split=False):
  """The deck as one self-contained page (the offline export, the default), or, split, as a page that links
  deck.css and deck.js, so it fits a policy of `default-src 'self'` (the portal, #1693)."""
  deck = outline["deck"]
  style = f'<link rel="stylesheet" href="{STYLE_FILE}">' if split else f"<style>{CSS}</style>"
  script = f'<script src="{SCRIPT_FILE}"></script>' if split else f"<script>{SCRIPT}</script>"
  words = {lang: {key: WORDS[lang][key] for key in ("notes", "references", "back", "referenceDeck", "noNotes", "copied", "index")} for lang in LANGS}
  main_index, refs_index = [], []
  main_slides, refs_slides = render_slides(outline, base, main_index), render_references(outline, refs_index)
  for lang in LANGS:
    words[lang]["title"] = text_of(deck, "title", lang) or deck["title"]
  words = json.dumps(words, ensure_ascii=False).replace("</", "<\\/")
  return f"""<!doctype html>
<html lang="en" data-lang="en" data-deck="{html.escape(deck.get('name', 'deck'))}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
